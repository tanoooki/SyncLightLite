{
  "name": "synclightlite",
  "version": "1.1.1",
  "private": false,
  "description": "Lightweight open-source HID ambient light/screen-sync controller for Robobloq SyncLight-style USB light strips",
  "main": "src/live.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:source": "node scripts/run-tests.js --source",
    "info": "node src/live.js info",
    "solid:red": "node src/live.js solid red",
    "live:10s": "node src/live.js live --duration 10",
    "package:release": "node scripts/package-release.js",
    "release:local": "npm run package:release && npm test"
  },
  "license": "MIT",
  "author": "Pichau and contributors",
  "homepage": "https://github.com/Tanoooki/SyncLightLite#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tanoooki/SyncLightLite.git"
  },
  "bugs": {
    "url": "https://github.com/Tanoooki/SyncLightLite/issues"
  },
  "keywords": [
    "ambient-light",
    "ambilight",
    "hid",
    "rgb",
    "robobloq",
    "synclight",
    "screen-sync",
    "windows",
    "tray-app"
  ],
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "optionalDependencies": {
    "@warren-robobloq/quiklight": "1.25.6"
  }
}
